#!/bin/sh
# AppImage entrypoint for Tempered Studio (the `rpro` CLI/TUI).
# Resolve our own location and exec the bundled binary, forwarding all args
# (e.g. `./Tempered_Studio-x86_64.AppImage exercise list`). Run with no args
# to drop into the TUI. Relocatable by construction — nothing is hard-coded.
HERE="$(dirname "$(readlink -f "${0}")")"
exec "${HERE}/usr/bin/rpro" "$@"
